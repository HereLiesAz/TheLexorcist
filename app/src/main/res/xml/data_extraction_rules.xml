<?xml version="1.0" encoding="utf-8"?>
<!--
    Cloud backup and device-to-device transfer rules for Android 12 and above.

    See backup_rules.xml: case data is privileged legal material and is not sent
    to Google account backup.

    Device transfer is excluded on the same reasoning. It is a direct copy
    rather than a cloud upload, but it is initiated by whoever is holding the
    new device, and the app has no way to tell that this is the same person.
    Cloud sync, which the user opts into explicitly, is the supported way to
    move a case load.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
